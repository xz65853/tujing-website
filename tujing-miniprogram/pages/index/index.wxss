/* ===== Hero ===== */
.hero {
  position: relative;
  background: linear-gradient(160deg, #0B1220 0%, #132A5C 60%, #155EEF 100%);
  padding: 100rpx 40rpx 80rpx;
  overflow: hidden;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
}
.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: 0.5;
}
.hero-glow-1 {
  width: 300rpx; height: 300rpx;
  background: #4D8BFF;
  top: -80rpx; right: -60rpx;
}
.hero-glow-2 {
  width: 200rpx; height: 200rpx;
  background: #7B61FF;
  bottom: -40rpx; left: -40rpx;
}
.hero-inner { position: relative; z-index: 2; }
.hero-tag {
  display: inline-block;
  background: rgba(255,255,255,0.15);
  color: #B8D4FF;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 32rpx;
}
.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.25;
  letter-spacing: -1rpx;
}
.hero-desc {
  color: rgba(255,255,255,0.7);
  font-size: 26rpx;
  margin-top: 20rpx;
}
.hero-stats {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(255,255,255,0.15);
}
.stat { flex: 1; text-align: center; }
.stat-num { display: block; font-size: 36rpx; font-weight: 700; color: #fff; }
.stat-label { display: block; font-size: 22rpx; color: rgba(255,255,255,0.6); margin-top: 4rpx; }
.stat-divider { width: 1rpx; height: 48rpx; background: rgba(255,255,255,0.15); }
.hero-actions { display: flex; gap: 20rpx; margin-top: 40rpx; }
.hero-btn { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 999rpx; font-size: 28rpx; font-weight: 600; }
.hero-btn.primary {
  background: #fff;
  color: #155EEF;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.2);
}
.hero-btn.ghost {
  background: rgba(255,255,255,0.15);
  color: #fff;
  border: 2rpx solid rgba(255,255,255,0.3);
}

/* ===== 服务卡片 ===== */
.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.service-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(21,94,239,0.05);
}
.service-icon {
  width: 80rpx; height: 80rpx;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 20rpx;
}
.service-icon-text { font-size: 36rpx; font-weight: 800; color: #155EEF; }
.service-name { font-size: 30rpx; font-weight: 700; color: #0B1220; }
.service-summary { font-size: 22rpx; color: #8A94A6; margin-top: 8rpx; line-height: 1.5; }

/* ===== 套餐卡片 ===== */
.product-list { margin-bottom: 10rpx; }
.product-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(21,94,239,0.06);
}
.product-badge {
  position: absolute; top: 0; right: 32rpx;
  background: linear-gradient(135deg, #FF6B35, #FF3B30);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 0 0 12rpx 12rpx;
}
.product-name { font-size: 32rpx; font-weight: 700; color: #0B1220; }
.product-sub { font-size: 24rpx; color: #8A94A6; margin-top: 8rpx; }
.product-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; }
.product-price-row { display: flex; align-items: baseline; }
.product-price { font-size: 44rpx; font-weight: 800; color: #FF3B30; }
.product-orig { font-size: 24rpx; color: #B0B8C4; text-decoration: line-through; margin-left: 12rpx; }
.product-arrow { font-size: 40rpx; color: #C8D0DC; }

/* ===== 案例卡片 ===== */
.case-list { display: flex; gap: 20rpx; overflow-x: auto; padding-bottom: 10rpx; }
.case-card {
  flex: 0 0 520rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(21,94,239,0.06);
}
.case-cover {
  height: 200rpx;
  background: linear-gradient(135deg, #155EEF, #7B61FF);
  display: flex; align-items: center; justify-content: center;
}
.case-cover-text { color: rgba(255,255,255,0.9); font-size: 32rpx; font-weight: 600; }
.case-body { padding: 24rpx; }
.case-title { font-size: 28rpx; font-weight: 600; color: #0B1220; }
.case-summary { font-size: 22rpx; color: #8A94A6; margin-top: 8rpx; line-height: 1.5; }

/* ===== 文章列表 ===== */
.article-list { background: #fff; border-radius: 24rpx; padding: 12rpx 28rpx; }
.article-item {
  display: flex; align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F4F6FB;
}
.article-item:last-child { border-bottom: none; }
.article-dot {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: #155EEF;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.article-title { font-size: 28rpx; color: #2D3748; flex: 1; }

/* ===== CTA ===== */
.cta-card {
  background: linear-gradient(135deg, #0B1220, #1A2F6B);
  border-radius: 28rpx;
  padding: 48rpx 36rpx;
  margin-top: 40rpx;
  text-align: center;
}
.cta-title { font-size: 34rpx; font-weight: 700; color: #fff; }
.cta-desc { font-size: 24rpx; color: rgba(255,255,255,0.6); margin-top: 12rpx; }
.cta-btn {
  display: inline-block;
  margin-top: 32rpx;
  background: #fff;
  color: #155EEF;
  padding: 20rpx 60rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}
