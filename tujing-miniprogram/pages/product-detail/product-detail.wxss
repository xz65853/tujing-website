.detail-hero {
  background: linear-gradient(160deg, #0B1220, #155EEF);
  padding: 80rpx 40rpx 100rpx;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}
.detail-name { font-size: 44rpx; font-weight: 800; color: #fff; }
.detail-sub { font-size: 26rpx; color: rgba(255,255,255,0.7); margin-top: 12rpx; }
.detail-price-row { display: flex; align-items: baseline; margin-top: 24rpx; }
.detail-price { font-size: 56rpx; font-weight: 800; color: #FFD700; }
.detail-orig { font-size: 26rpx; color: rgba(255,255,255,0.5); text-decoration: line-through; margin-left: 16rpx; }

.feat {
  display: flex; align-items: flex-start;
  padding: 16rpx 0;
  color: #2D3748; font-size: 28rpx; line-height: 1.6;
}
.feat-check {
  color: #155EEF;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.buy-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  display: flex; align-items: center;
  border-top: 2rpx solid #EEF2F7;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}
.buy-price { flex: 1; }
.buy-label { font-size: 22rpx; color: #8A94A6; }
.buy-amount { font-size: 40rpx; font-weight: 800; color: #FF3B30; }
.buy-btn {
  background: linear-gradient(135deg, #155EEF, #4D8BFF);
  color: #fff;
  padding: 24rpx 60rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(21,94,239,0.3);
}
