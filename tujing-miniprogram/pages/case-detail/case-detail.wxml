<view class="container" wx:if="{{detail}}">
  <view class="muted" style="font-size:24rpx">{{detail.industry}} · {{detail.projectType}}</view>
  <view class="title" style="margin-top:12rpx">{{detail.title}}</view>
  <view class="muted" style="margin-top:16rpx">{{detail.subtitle}}</view>

  <view class="card" style="margin-top:32rpx">
    <view class="h2">项目背景</view>
    <view style="margin-top:16rpx; white-space:pre-line; color:#4A5568">{{detail.background}}</view>
  </view>
  <view class="card">
    <view class="h2">运营策略</view>
    <view style="margin-top:16rpx; white-space:pre-line; color:#4A5568">{{detail.strategy}}</view>
  </view>
  <view class="card">
    <view class="h2">执行内容</view>
    <view style="margin-top:16rpx; white-space:pre-line; color:#4A5568">{{detail.execution}}</view>
  </view>
  <view class="card" wx:if="{{detail.dataVisible && detail.metrics.length}}">
    <view class="h2">项目数据</view>
    <view class="metric-grid">
      <view class="metric" wx:for="{{detail.metrics}}" wx:key="label">
        <view class="metric-value">{{item.value}}</view>
        <view class="metric-label">{{item.label}}</view>
      </view>
    </view>
  </view>
  <view class="card">
    <view class="h2">项目结果</view>
    <view style="margin-top:16rpx; white-space:pre-line; color:#4A5568">{{detail.result}}</view>
  </view>
</view>
<view class="container muted" wx:if="{{loading}}">加载中…</view>
