<view class="container" style="text-align:center; padding-top:120rpx">
  <view style="font-size:96rpx">{{paid ? "✅" : "⏳"}}</view>
  <view class="title" style="margin-top:24rpx">{{paid ? "支付成功" : "订单已创建"}}</view>
  <view class="muted" style="margin-top:16rpx">{{paid ? "我们会在 1 个工作日内与你联系" : "支付可能已取消或未完成，可在我的订单中查看"}}</view>

  <view class="card" style="margin-top:60rpx; text-align:left" wx:if="{{order}}">
    <view class="muted" style="font-size:24rpx">订单号</view>
    <view style="font-family:monospace; margin:8rpx 0 20rpx">{{order.outTradeNo}}</view>
    <view class="muted" style="font-size:24rpx">套餐</view>
    <view style="margin:8rpx 0">{{order.product.name}}</view>
    <view class="muted" style="font-size:24rpx">金额</view>
    <view class="price" style="margin:8rpx 0">¥{{order.amount}}</view>
  </view>

  <view class="btn-primary" style="margin-top:60rpx" bindtap="goOrders">查看我的订单</view>
  <view class="btn-ghost" style="margin-top:20rpx" bindtap="goHome">返回首页</view>
</view>
