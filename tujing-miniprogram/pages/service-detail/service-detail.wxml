<view class="container" wx:if="{{detail}}">
  <view class="card">
    <view class="brand" style="font-size:22rpx">{{detail.nameEn}}</view>
    <view class="title" style="margin-top:12rpx">{{detail.name}}</view>
    <view class="muted" style="margin-top:16rpx">{{detail.summary}}</view>
  </view>

  <view class="card">
    <view class="h2">服务包含</view>
    <view style="margin-top:20rpx">
      <text class="tag" wx:for="{{detail.features}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{detail.description}}">
    <view class="h2">服务说明</view>
    <view style="margin-top:16rpx; white-space:pre-line; color:#4A5568">{{detail.description}}</view>
  </view>

  <view class="btn-primary" bindtap="goContact">咨询这项服务</view>
</view>
<view class="container muted" wx:if="{{loading}}">加载中…</view>
