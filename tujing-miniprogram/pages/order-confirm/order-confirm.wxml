<view class="container" wx:if="{{product}}">
  <view class="card">
    <view class="muted" style="font-size:24rpx">订单内容</view>
    <view class="title" style="margin-top:12rpx">{{product.name}}</view>
    <view class="muted" style="margin-top:8rpx">{{product.subtitle}} · {{product.duration}}</view>
    <view class="price" style="margin-top:20rpx">¥{{product.price}}</view>
  </view>

  <view class="card">
    <view class="h2" style="margin-bottom:20rpx">联系信息</view>
    <input class="input" placeholder="您的称呼" value="{{contactName}}" bindinput="onName" />
    <input class="input" placeholder="手机号" type="number" maxlength="11" value="{{contactPhone}}" bindinput="onPhone" />
    <textarea class="input" placeholder="备注（选填）" value="{{remark}}" bindinput="onRemark" auto-height />
  </view>

  <view class="btn-primary" bindtap="submit">{{submitting ? "提交中…" : "提交订单"}}</view>
</view>
