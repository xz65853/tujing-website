.page-head {
  background: linear-gradient(160deg, #0B1220, #155EEF);
  padding: 80rpx 40rpx 60rpx;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}
.page-title { font-size: 44rpx; font-weight: 800; color: #fff; }
.page-sub { font-size: 24rpx; color: rgba(255,255,255,0.7); margin-top: 12rpx; line-height: 1.5; }

.product-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(21,94,239,0.06);
  margin-top: 24rpx;
}
.product-badge {
  position: absolute; top: 0; right: 32rpx;
  background: linear-gradient(135deg, #FF6B35, #FF3B30);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 0 0 12rpx 12rpx;
}
.product-name { font-size: 34rpx; font-weight: 700; color: #0B1220; }
.product-sub { font-size: 24rpx; color: #8A94A6; margin-top: 8rpx; }
.product-summary { font-size: 24rpx; color: #8A94A6; margin-top: 16rpx; line-height: 1.6; }
.product-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 24rpx; padding-top: 24rpx; border-top: 2rpx solid #F4F6FB; }
.product-price-row { display: flex; align-items: baseline; }
.product-price { font-size: 48rpx; font-weight: 800; color: #FF3B30; }
.product-orig { font-size: 24rpx; color: #B0B8C4; text-decoration: line-through; margin-left: 12rpx; }
.product-btn { font-size: 26rpx; color: #155EEF; font-weight: 500; }
