# 开发默认使用 SQLite，零配置即可运行
DATABASE_URL="file:./dev.db"

# 用于登录 Session 签名的密钥（生产环境请改成随机长字符串）
AUTH_SECRET="change-me-to-a-long-random-secret-string"

# 后台初始管理员（仅首次 seed 时写入）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123456"

# ===== 切换到 MySQL 时：1) 改 prisma/schema.prisma 的 provider 为 mysql =====
# =====                2) 把下面这行取消注释并填写连接串             =====
# DATABASE_URL="mysql://user:password@host:3306/tujing"

# ===== 微信小程序 =====
WECHAT_APPID=""
WECHAT_SECRET=""

# ===== 微信支付 v3（小程序内购套餐用）=====
WECHAT_MCHID=""
WECHAT_APIV3_KEY=""
WECHAT_SERIAL_NO=""
WECHAT_PRIVATE_KEY_PATH=""
WECHAT_NOTIFY_URL="https://你的域名/api/wechat/notify"
