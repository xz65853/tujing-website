// 切换到 MySQL：把 provider 改成 "mysql"，并在 .env 中配置 DATABASE_URL 即可。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 管理员角色用字符串：SUPER_ADMIN / OPERATOR / SALES
model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("SUPER_ADMIN")
  createdAt    DateTime @default(now())
  leads        Lead[]   @relation("AssignedTo")
  followups    LeadFollowup[]
}

model ServiceCategory {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String @unique
  sort  Int    @default(0)
  items Service[]
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  nameEn      String?
  icon        String?
  summary     String?
  description String?
  // JSON 字符串数组：["账号定位","内容策划"]
  features    String?
  audience    String?
  seoTitle    String?
  seoDesc     String?
  sort        Int      @default(0)
  published   Boolean  @default(true)
  categoryId  Int?
  category    ServiceCategory? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
}

model CaseCategory {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String @unique
  sort  Int    @default(0)
  cases Case[]
}

model Case {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  subtitle    String?
  industry    String?
  projectType String?
  cover       String?
  summary     String?
  background  String?
  strategy    String?
  execution   String?
  result      String?
  // 是否在前台展示项目数据（未核实数据时关闭，避免虚假宣传）
  dataVisible Boolean  @default(false)
  // JSON 字符串：[{"label":"播放量","value":"xx"}]
  metrics     String?
  images      String?
  video       String?
  seoTitle    String?
  seoDesc     String?
  featured    Boolean  @default(false)
  status      String   @default("draft") // draft / published / archived
  sort        Int      @default(0)
  categoryId  Int?
  category    CaseCategory? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ArticleCategory {
  id    Int       @id @default(autoincrement())
  name  String
  slug  String    @unique
  posts Article[]
}

model Article {
  id         Int      @id @default(autoincrement())
  title      String
  slug       String   @unique
  cover      String?
  summary    String?
  content    String?
  author     String?
  publishedAt DateTime?
  seoTitle   String?
  seoDesc    String?
  status     String   @default("draft") // draft / published / archived
  categoryId Int?
  category   ArticleCategory? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 客户线索 / CRM
model Lead {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String
  company     String?
  city        String?
  industry    String?
  // 逗号分隔的需求：抖音代运营,短视频
  requirements String?
  message     String?
  source      String?
  sourcePage  String?
  status      String   @default("pending") // pending/contacted/intention/quoted/deal/lost/invalid
  assignedToId Int?
  assignedTo  Admin?   @relation("AssignedTo", fields: [assignedToId], references: [id])
  followups   LeadFollowup[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

model LeadFollowup {
  id              Int      @id @default(autoincrement())
  leadId          Int
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  adminId         Int?
  admin           Admin?   @relation(fields: [adminId], references: [id])
  content         String
  nextFollowupAt DateTime?
  createdAt       DateTime @default(now())
}

model Banner {
  id          Int      @id @default(autoincrement())
  image       String?
  title       String?
  subtitle    String?
  buttonText  String?
  buttonLink  String?
  sort        Int      @default(0)
  startAt     DateTime?
  endAt       DateTime?
  active      Boolean  @default(true)
}

model Media {
  id        Int      @id @default(autoincrement())
  url       String
  name      String
  type      String   // image / video
  size      Int?
  createdAt DateTime @default(now())
}

// 单例站点设置（id 固定为 1）
model SiteSetting {
  id           Int     @id @default(1)
  companyName  String  @default("湖南途鲸文化传媒有限公司")
  slogan       String  @default("实体企业线上增长服务商")
  description  String?
  logo         String?
  phone        String?
  email        String?
  address      String?
  wechatQr     String?
  icp          String?
  douyin       String?
  xiaohongshu  String?
  siteTitle    String?
  siteDesc     String?
  siteKeywords String?
}

// ===== 微信小程序 =====

// 微信小程序用户
model Member {
  id        Int      @id @default(autoincrement())
  openid    String   @unique
  unionid   String?
  nickname  String?
  avatar    String?
  phone     String?
  city      String?
  // 会话 token（简化版：后端签发，小程序缓存）
  token     String?   @unique
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 可在线购买的服务套餐（小程序里展示）
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  subtitle    String?
  cover       String?
  // 单位：分
  price       Int
  // 划线价（单位：分），选填
  originalPrice Int?
  duration    String?  // 如 "1个月"
  summary     String?
  // JSON 字符串：["包含 4 条短视频","账号诊断"]
  features    String?
  // 详情富文本
  detail      String?
  sort        Int      @default(0)
  published   Boolean  @default(true)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 微信支付订单
model Order {
  id                  Int      @id @default(autoincrement())
  // 商户订单号，也是微信支付 out_trade_no
  outTradeNo          String   @unique
  memberId            Int
  member              Member   @relation(fields: [memberId], references: [id])
  productId           Int
  product             Product  @relation(fields: [productId], references: [id])
  // 金额（单位：分）
  amount              Int
  // pending / paid / delivered / completed / refunded / closed
  status              String   @default("pending")
  // 微信支付交易号
  transactionId       String?
  // 联系人信息（下单时填写）
  contactName         String?
  contactPhone       String?
  remark              String?
  paidAt              DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@index([memberId])
  @@index([outTradeNo])
}
